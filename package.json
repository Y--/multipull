{
  "name": "multipull",
  "version": "2.2.19",
  "description": "Pull multiple git repositories",
  "main": "pullRepos.js",
  "scripts": {
    "format": "prettier --write './**/*.js' '*.js'",
    "lint": "./node_modules/.bin/eslint '**/*.js'",
    "release": "npm version patch && npm publish",
    "test": "./node_modules/.bin/jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Y--/multipull.git"
  },
  "author": "Yves Le Maout <y.lemaout@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "bugs": {
    "url": "https://github.com/Y--/multipull/issues"
  },
  "bin": {
    "multicheckout": "bin/multicheckout",
    "multiexec": "bin/multiexec",
    "multilist": "bin/multilist",
    "multimerge": "bin/multimerge",
    "multimergepr": "bin/multimergepr",
    "multipr": "bin/multipr",
    "multipull": "bin/multipull",
    "multipull-completion": "bin/multipull-completion",
    "multipush": "bin/multipush",
    "multirebase": "bin/multirebase",
    "multistatus": "bin/multistatus"
  },
  "homepage": "https://github.com/Y--/multipull#readme",
  "dependencies": {
    "@bomb.sh/tab": "^0.0.22",
    "@octokit/rest": "^22.0.1",
    "cli-table": "Automattic/cli-table#b9ebd7570e20d885b7455c696d8fd2fcaa3c503f",
    "colors": "^1.4.0",
    "debug": "^4.4.3",
    "ini": "^7.0.0",
    "progress": "^2.0.3",
    "rc": "^1.2.8",
    "simple-git": "4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9"
  }
}
